---
import Base from '../layouts/Base.astro';
import { crew, cropStyle } from '../data/crew';
import hero from '../assets/hero-crew.png';
const lost = crew.find((c) => c.slug === 'skull-hood') ?? crew[0];
---
<Base title="Not found">
  <section class="wrap hero">
    <h1 class="post-title" style="margin-top:40px">404</h1>
    <div class="lost-shot" style={cropStyle(lost.box, hero.src, 260)}></div>
    <p class="hero-tag">That page doesn't exist.</p>
    <div class="cta-row"><a class="cta" href="/">Back to the front</a></div>
  </section>
</Base>

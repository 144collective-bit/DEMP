---
/* Every v1 URL now 404s. Rather than a dead end, point back at the one page
   that exists. */
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../data/site';
---
<Base title="Not found" description={`${SITE_NAME} is being rebuilt.`}>
  <section class="nf">
    <p class="code">404</p>
    <h1>Nothing here yet</h1>
    <p class="tag">That page went with the old site. The new one is on its way.</p>
    <a class="cta" href="/">Back to the front</a>
  </section>
</Base>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-height: 100svh;
    padding: 2rem 1.25rem;
    text-align: center;
  }

  .code {
    margin: 0;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: clamp(3rem, 14vw, 6rem);
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
  }

  h1 {
    margin: 0;
    font-size: clamp(1.4rem, 5vw, 2rem);
    letter-spacing: -0.01em;
  }

  .tag {
    margin: 0;
    max-width: 34ch;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.95rem;
    color: var(--ink-dim);
  }

  .cta {
    margin-top: 0.75rem;
    padding: 0.8rem 1.6rem;
    border: 2px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .cta:hover,
  .cta:focus-visible {
    background: var(--accent);
    color: #071a04;
  }
</style>

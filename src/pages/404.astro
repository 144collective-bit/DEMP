---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import lost from '../assets/team/purple-third-eye.png';
---
<Base title="Not found">
  <section class="wrap hero">
    <h1 class="post-title" style="margin-top:40px">404</h1>
    <Image class="lost-shot" src={lost} alt="" widths={[260, 440]} sizes="260px" />
    <p class="hero-tag">That page doesn't exist.</p>
    <div class="cta-row"><a class="cta" href="/">Back to the front</a></div>
  </section>
</Base>

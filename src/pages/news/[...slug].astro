---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FollowCta from '../../components/FollowCta.astro';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---
<Base title={post.data.title} description={post.data.summary}>
  <article class="wrap post">
    <p class="eyebrow">
      <a href="/news">News</a> &nbsp;/&nbsp; {fmt(post.data.date)}
    </p>
    <h1 class="post-title">{post.data.title}</h1>
    <p class="post-summary">{post.data.summary}</p>
    <div class="post-body"><Content /></div>

    {/* Every post in the collection is placeholder copy. The notice is on the
        template rather than in each file so it cannot be forgotten -- delete
        this block at the same time as the placeholder posts. */}
    <div class="notice post-notice">
      <span class="tag">Draft copy</span>
      <p>This post is placeholder written in the brand voice to show the
      template working. It does not report anything that actually happened.</p>
    </div>

    <FollowCta label="Follow for the next one" />
  </article>
</Base>

---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FollowCta from '../components/FollowCta.astro';
import Ticker from '../components/Ticker.astro';
import TeamGrid from '../components/TeamGrid.astro';
import hero from '../assets/hero-crew.png';
import { projects } from '../data/projects';
import { SITE_NAME, X_HANDLE } from '../data/site';

const posts = (await getCollection('news'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// The front page shows what is moving, not the full list -- parked things are
// honest on /projects but make a poor shop window.
// Three, to match "Latest" and to fill the desktop row exactly rather than
// stranding a fourth card on its own.
const featured = projects.filter((p) => p.status !== 'Parked').slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const slug = (s: string) => s.toLowerCase().replace(/[^a-z]+/g, '-');
---
<Base description="Stickers, a crew of five, and the projects The Degen Emporium keeps building. Drawn on black, cut for dark surfaces.">
  <section class="hero wrap">
    {/* The wordmark is baked into the artwork, so the real page heading
        lives here for search engines and screen readers. */}
    <h1 class="vh">{SITE_NAME}</h1>
    <div class="hero-bleed">
      <Image class="hero-art" src={hero}
        alt="The Degen Emporium crew: masked characters and mascots flanking the graffiti wordmark"
        widths={[560, 900, 1105]} sizes="(max-width: 720px) 100vw, 980px"
        loading="eager" fetchpriority="high" />
    </div>
    {/* Draft copy, written not supplied -- approve or replace. */}
    <p class="hero-tag">A crew of degens, a pile of stickers,<br><b>and the projects we keep building.</b></p>
    <FollowCta label={`Follow @${X_HANDLE}`} />
  </section>

  <Ticker />

  <section class="wrap section">
    <div class="section-head">
      <h2>The Team</h2>
      <a href="/team">Meet everyone &rarr;</a>
    </div>
    <TeamGrid compact />
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>On the bench</h2>
      <a href="/projects">The full list &rarr;</a>
    </div>
    <ul class="proj-grid proj-grid-home">
      {featured.map((p) => (
        <li class="proj-card">
          <p class="proj-kind">{p.kind}</p>
          <h3>{p.name}</h3>
          <p class="proj-line">{p.line}</p>
          <p class={`status status-${slug(p.status)}`}>{p.status}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>Latest</h2>
      <a href="/news">All news &rarr;</a>
    </div>
    <div class="news-list">
      {posts.map((p) => (
        <article class="news-item">
          <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
          <div>
            <h3><a href={`/news/${p.id}/`}>{p.data.title}</a></h3>
            <p>{p.data.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap section">
    <div class="duo">
      <a class="panel" href="/shop">
        <span class="panel-k">01</span>
        <h3>Shop</h3>
        <p>The whole sticker range on one sheet. Checkout not wired yet.</p>
      </a>
      <a class="panel" href="/links">
        <span class="panel-k">02</span>
        <h3>Links</h3>
        <p>Names you'll run into out here. Links only, no commentary.</p>
      </a>
      <a class="panel" href="/about">
        <span class="panel-k">03</span>
        <h3>About</h3>
        <p>How a running joke turned into a sticker company.</p>
      </a>
    </div>

    <div class="notice">
      <span class="tag">Draft copy &mdash; approve before launch</span>
      <p>Everything written on this site is placeholder in the brand voice,
      including the line under the artwork above. It is here so the finished
      site can be seen and reacted to, not because any of it is settled.</p>
    </div>
  </section>
</Base>

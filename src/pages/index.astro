---
/* The v1 site (home, about, team, projects, shop, links, news) was removed on
   purpose -- this domain now serves a single holding page while the new site
   is built. The old pages are still in git history at f1c62ba on main:
   `git checkout f1c62ba -- src` brings any of them back. */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import art from '../assets/coming-soon.jpg';
import { SITE_NAME, X_HANDLE, X_URL } from '../data/site';
---
<Base description="The Degen Emporium is being rebuilt. New site coming soon.">
  <section class="holding">
    {/* The wordmark and "COMING SOON" are baked into the artwork, so the real
        heading lives here for search engines and screen readers. */}
    <h1 class="vh">{SITE_NAME} - coming soon</h1>

    <div class="art-frame">
      <Image
        class="art"
        src={art}
        alt="The Degen Emporium graffiti wordmark beside a masked figure in a suit, above the words COMING SOON"
        widths={[640, 1000, 1400, 2000]}
        sizes="(max-width: 720px) 135vw, (max-width: 1180px) 100vw, 1120px"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <p class="tag">Shop's shut while we build the new one.</p>

    <a class="cta" href={X_URL} rel="me noopener">Follow @{X_HANDLE}</a>
  </section>
</Base>

<style>
  .holding {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 3.5vw, 2.25rem);
    min-height: 100svh;
    /* The artwork runs edge to edge on phones; the padding only ever applies
       to the text below it. */
    padding: clamp(1.5rem, 5vw, 3rem) 0 clamp(2.5rem, 7vw, 4rem);
    text-align: center;
  }

  /* The artwork is a bright plate on a dark page, so its edge always shows.
     Rounding it and lighting it from behind makes that edge read as a
     deliberate poster rather than a seam. */
  .art-frame {
    width: min(100%, 1120px);
    overflow: hidden;
    border-radius: 20px;
    box-shadow: 0 0 80px -20px rgba(120, 255, 60, 0.45);
  }

  .art {
    display: block;
    width: 100%;
    height: auto;
  }

  /* A 16:9 banner shrunk to phone width leaves the wordmark tiny and the page
     mostly empty. Bleed to the edges and crop into the sparse left starfield
     instead, so the art fills its share of the screen. */
  @media (max-width: 720px) {
    .art-frame {
      width: 100vw;
      border-radius: 0;
      box-shadow: none;
    }

    .art {
      width: 135%;
      margin-left: -19%;
    }
  }

  .tag {
    margin: 0;
    padding: 0 1.25rem;
    font-family: 'Space Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: clamp(0.95rem, 2.4vw, 1.15rem);
    letter-spacing: 0.02em;
    color: var(--ink-dim);
  }

  .cta {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    border: 2px solid var(--accent);
    border-radius: 999px;
    background: transparent;
    color: var(--accent);
    font-weight: 700;
    font-size: clamp(0.95rem, 2.4vw, 1.1rem);
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 120ms ease, color 120ms ease, transform 120ms ease;
  }

  .cta:hover,
  .cta:focus-visible {
    background: var(--accent);
    color: #071a04;
  }

  .cta:active { transform: translateY(1px); }

  @media (prefers-reduced-motion: reduce) {
    .cta { transition: none; }
  }
</style>

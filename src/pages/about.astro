---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Base title="About">
  <div class="wrap">
    <PageHeader name="about" title="About" />
    <div class="prose" style="margin-top:26px">
      <div class="notice">
        <span class="tag">Needs copy</span>
        <p>Waiting on the positioning call: is this a personal site with a brand
        around it, or the Emporium's site with a named operator behind it? The
        voice of this page follows from that.</p>
      </div>
    </div>
  </div>
</Base>

---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import FollowCta from '../components/FollowCta.astro';
import { products } from '../data/shop';
import sheet from '../assets/sticker-sheet.png';
---
<Base
  title="Shop"
  description="The Degen Emporium sticker range. Placeholder line-up — checkout is not wired and no prices are set."
>
  <div class="wrap">
    <PageHeader name="shop" title="Shop" />
    <p class="prose lede">Stickers. The whole range, drawn to be slapped on something.</p>

    <figure class="sheet">
      {/* The sheet fills .wrap's content box, so its width is
          min(1120px, 100vw) - 48px -- never 94vw. The old hint understated
          the desktop box by 32px and upscaled the image into it. */}
      <Image src={sheet} alt="The Degen Emporium sticker range: balaclavas, mascots, crypto slang and ecosystem marks, die-cut on black"
             width={1536} widths={[720, 1072, 1536]}
             sizes="(max-width: 1168px) calc(100vw - 48px), 1072px" />
      <figcaption>Every design in the range, on one sheet.</figcaption>
    </figure>

    <div class="notice">
      <span class="tag">Placeholder line-up &mdash; nothing is on sale</span>
      <p>The packs below are draft names and draft copy, written so the page can
      be seen fully populated. No prices have been set, so none are shown &mdash;
      a made-up price on a public page is a lie with a currency symbol on it.</p>
    </div>

    <section class="section shop-section" aria-labelledby="range-h">
      <div class="section-head">
        <h2 id="range-h">The packs</h2>
        <a href="/projects">How the range gets made &rarr;</a>
      </div>

      <ul class="shop-grid">
        {products.map((p) => (
          <li class="shop-card">
            <div class="shop-body">
              <h3>{p.name}</h3>
              <p class="shop-line">{p.line}</p>
            </div>
            <p class="price">
              <span class="price-k">Price</span>
              <span class="price-v" aria-hidden="true">{p.price}</span>
              <span class="vh">not set yet</span>
            </p>
          </li>
        ))}
      </ul>
    </section>

    <div class="notice">
      <span class="tag">Checkout not wired yet</span>
      <p>A static site can't take payments on its own. Pick a route &mdash;
      print-on-demand (Printful), hosted checkout (Gumroad, Shopify Lite), or
      linking out to a storefront you already run &mdash; and this becomes a
      real shop. Individual products need per-sticker art and prices.</p>
    </div>

    <FollowCta label="Follow to hear when it opens" />
  </div>
</Base>

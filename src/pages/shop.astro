---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Base title="Shop">
  <div class="wrap">
    <PageHeader name="shop" title="Shop" />
    <div class="prose" style="margin-top:26px">
      <div class="notice">
        <span class="tag">Blocked on a decision</span>
        <p>A static site cannot take payments by itself. Pick a route &mdash;
        print-on-demand (Printful), hosted checkout (Gumroad, Shopify Lite), or
        link out to an existing storefront &mdash; and this page gets built to it.</p>
      </div>
    </div>
  </div>
</Base>

---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Base title="Contact">
  <div class="wrap">
    <PageHeader name="contact" title="Contact" />
    <div class="prose" style="margin-top:26px">
      <div class="notice">
        <span class="tag">Needs a destination</span>
        <p>Static sites need a form service (Formspree, or a small Cloudflare
        Worker) or a plain mailto address. Say which and this becomes a working
        form.</p>
      </div>
    </div>
  </div>
</Base>

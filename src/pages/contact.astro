---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { X_URL, X_HANDLE } from '../data/site';

// The form below is a LAYOUT, not a form. This is a static build with no
// backend, so every field is `disabled` and the submit button is `disabled`:
// a live-looking form that silently drops messages is worse than no form.
// Wiring it up = pick a destination (Formspree, a Worker, a mailto), set the
// `action`, and delete the `disabled` attributes plus the .form-dead class.
const fields = [
  { id: 'name',    label: 'Name',    type: 'text',  autocomplete: 'name',  hint: 'Or a handle. We are not checking.' },
  { id: 'email',   label: 'Email',   type: 'email', autocomplete: 'email', hint: 'Only used to reply.' },
  { id: 'subject', label: 'Subject', type: 'text',  autocomplete: 'off',   hint: 'One line.' },
];
---
<Base
  title="Contact"
  description="How to reach The Degen Emporium. The form on this page is a layout only — the site is static and cannot send it."
>
  <div class="wrap">
    <PageHeader name="contact" title="Contact" />

    <p class="prose lede">
      Wholesale, artwork, something broken on this site, or a correction. All of
      it is welcome. None of it can go through the form yet.
    </p>

    <div class="notice">
      <span class="tag">This form does not send</span>
      <p id="form-status">The site is a static build with no backend, so the
      form below is a <strong>layout only</strong> — every field is switched off
      and nothing you type would go anywhere. It is here so the finished page
      can be seen. Until a destination is chosen (a form service, a small
      worker, or a plain address), use the link underneath it.</p>
    </div>

    <div class="contact-cols">
      <section class="contact-form-col" aria-labelledby="form-h">
        <h2 id="form-h">Send a message</h2>

        <form class="form form-dead" aria-describedby="form-status">
          {fields.map((f) => (
            <p class="field">
              <label for={f.id}>{f.label}</label>
              <input type={f.type} id={f.id} name={f.id} autocomplete={f.autocomplete} disabled />
              <span class="field-hint">{f.hint}</span>
            </p>
          ))}

          <p class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="6" disabled></textarea>
            <span class="field-hint">Short is fine.</span>
          </p>

          <p class="field field-actions">
            <button class="cta cta-sm" type="submit" disabled>Send</button>
            <span class="field-hint">Disabled &mdash; no destination wired.</span>
          </p>
        </form>
      </section>

      <section class="contact-side" aria-labelledby="reach-h">
        <h2 id="reach-h">What does work</h2>

        <ul class="reach-list">
          <li>
            <span class="reach-k">Everything</span>
            <a href={X_URL} rel="me noopener" target="_blank">X / @{X_HANDLE}</a>
            <p>The account is real and the messages get read. It is currently
            the only route in.</p>
          </li>
          <li>
            <span class="reach-k">Something broken</span>
            <a href={X_URL} rel="me noopener" target="_blank">Same place</a>
            <p>A screenshot and the page you were on is enough. Tell us the
            phone, too, if it looked wrong on a phone.</p>
          </li>
        </ul>

        <div class="notice">
          <span class="tag">Placeholder</span>
          <p>No postal address, phone number or support address is listed
          because none has been supplied, and inventing one would be worse than
          leaving the space empty.</p>
        </div>
      </section>
    </div>
  </div>
</Base>

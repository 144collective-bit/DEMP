---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { links } from '../data/links';

import pulsechain from '../assets/links/pulsechain-com.webp';
import hex from '../assets/links/hex-com.webp';
import pulsex from '../assets/links/pulsex-com.webp';
import provex from '../assets/links/provex-com.webp';

const art: Record<string, ImageMetadata> = {
  'pulsechain-com': pulsechain,
  'hex-com': hex,
  'pulsex-com': pulsex,
  'provex-com': provex,
};
---
<Base
  title="Links"
  description="Outbound links to PulseChain ecosystem project sites. Links only — no descriptions, ratings or endorsements."
>
  <div class="wrap">
    {/* No graffiti header art exists for Links, so this page uses the
        display face. Worth having one drawn to match the other six. */}
    <div class="pagehead texthead">
      <h1>Links</h1>
    </div>

    <p class="prose lede">
      Names you will run into constantly out here. Every row goes straight to
      that project's own site.
    </p>

    {/* These are real, third-party projects. This page is a set of outbound
        links and nothing more -- see the comment at the top of data/links.ts. */}
    <p class="prose disclaimer">
      We link these. We do not run them, speak for them, rate them or explain
      them, and nothing on this site is advice about what to do with your money.
      Read each project's own site and make your own mind up.
    </p>

    <ul class="linklist">
      {links.map((l) => (
        <li class="linkitem">
          <a class="linkrow" href={l.url} target="_blank" rel="noopener">
            <span class="linkmark">
              {/* The marks are height-constrained in CSS (54px, dropping to
                  34px on a phone), so the widest any of them ever renders is
                  about 180px -- the old 340px hint was serving roughly four
                  times the pixels needed. */}
              <Image src={art[l.slug]} alt={l.name}
                     width={400} widths={[200, 400]} sizes="200px" />
            </span>
            <span class="linkdomain">{l.domain}</span>
            <span class="linkarrow" aria-hidden="true">&rarr;</span>
          </a>
          <p class="linkblurb">{l.blurb}</p>
        </li>
      ))}
    </ul>

    <div class="notice">
      <span class="tag">Draft copy &mdash; replace before launch</span>
      <p>The line under each project is deliberately generic placeholder: it
      describes the link, not the project. Nothing specific will be written here
      about someone else's work without it coming from them. If real
      descriptions are wanted, they need to be supplied and signed off.</p>
    </div>
  </div>
</Base>

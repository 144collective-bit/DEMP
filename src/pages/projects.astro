---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import FollowCta from '../components/FollowCta.astro';
import { projects, type ProjectStatus } from '../data/projects';

// Grouped by status rather than listed flat: the status is the most useful
// thing on the page, and grouping means each group gets a real <h2> instead of
// nine <h3>s hanging off nothing.
const order: ProjectStatus[] = ['Shipped', 'In progress', 'Sketching', 'Parked'];
const blurbs: Record<ProjectStatus, string> = {
  'Shipped': 'Out in the world. Done is done.',
  'In progress': 'Being worked on now. No dates, on purpose.',
  'Sketching': 'Exists as an idea and some drawings. May never be more than that.',
  'Parked': 'Looked at, thought about, deliberately stopped.',
};

const groups = order
  .map((status) => ({ status, blurb: blurbs[status], items: projects.filter((p) => p.status === status) }))
  .filter((g) => g.items.length > 0);

const slug = (s: string) => s.toLowerCase().replace(/[^a-z]+/g, '-');
---
<Base
  title="Projects"
  description="What The Degen Emporium is building: sticker drops, art series and the things that got parked."
>
  <div class="wrap">
    <PageHeader name="projects" title="Projects" />

    <p class="prose lede">
      Sticker drops, art series and the odd thing that never made it out of a
      sketchbook. Everything the Emporium builds for itself lives here — other
      people's sites are over on <a href="/links">Links</a>.
    </p>

    <div class="notice">
      <span class="tag">Draft copy &mdash; replace before launch</span>
      <p>Every entry below is placeholder, written to show the page fully
      populated. None of it describes work that has actually happened. Send the
      real list and it swaps out in one file.</p>
    </div>

    {groups.map((g) => (
      <section class="proj-group">
        <div class="proj-grouphead">
          <h2 id={`status-${slug(g.status)}`}>{g.status}</h2>
          <p>{g.blurb}</p>
        </div>
        <ul class="proj-grid" aria-labelledby={`status-${slug(g.status)}`}>
          {g.items.map((p) => (
            <li class="proj-card">
              <p class="proj-kind">{p.kind}</p>
              <h3>{p.name}</h3>
              <p class="proj-line">{p.line}</p>
              <p class={`status status-${slug(p.status)}`}>{p.status}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <FollowCta label="Follow for the next drop" />
  </div>
</Base>

---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import TeamGrid from '../components/TeamGrid.astro';
---
<Base title="Team" description="The five degens behind The Degen Emporium.">
  <div class="wrap">
    <PageHeader name="team" title="Team" />
    <p class="prose lede">Five degens. One of them owns a suit.</p>
    <div class="notice">
      <span class="tag">Draft copy &mdash; approve before launch</span>
      <p>Names and bios below are written, not supplied. Only <strong>Degen</strong>
      is confirmed. Say the word on any that miss and they change in one file.</p>
    </div>
    {/* The grid's cards are <h3>s, so they need an <h2> above them or the
        page outline jumps straight from h1 to h3. */}
    <div class="section-head" style="margin-top:34px">
      <h2>The five</h2>
      <a href="/about">How this started &rarr;</a>
    </div>
    <TeamGrid />
  </div>
</Base>

---
import { Image } from 'astro:assets';
import { team } from '../data/team';

import theSuit from '../assets/team/the-suit.png';
import blue from '../assets/team/blue-balaclava.png';
import gold from '../assets/team/gold-mask.png';
import purple from '../assets/team/purple-third-eye.png';
import pink from '../assets/team/pink-balaclava.png';

const art: Record<string, ImageMetadata> = {
  'the-suit': theSuit,
  'blue-balaclava': blue,
  'gold-mask': gold,
  'purple-third-eye': purple,
  'pink-balaclava': pink,
};

interface Props { compact?: boolean; }
const { compact = false } = Astro.props;

// .team-grid is repeat(auto-fill, minmax(250px, 1fr)) with a 20px gap inside
// .wrap (max 1120px, 24px gutters), so the column count steps at fixed
// viewport widths and the card is widest just before each step:
//
//   < 568px   1 col   -> 100vw - 48px      (up to 519px)
//   < 838px   2 cols  -> (100vw - 68px)/2  (up to 385px)
//   < 1108px  3 cols  -> (100vw - 88px)/3  (up to 340px)
//   >= 1108px 4 cols  -> 253px
//
// The old "46vw" hint understated the phone case by half. The two widths are
// shared with the chip and the 404 so the build emits three variants per
// portrait rather than five.
const GRID_SIZES = [
  '(max-width: 567px) calc(100vw - 48px)',
  '(max-width: 837px) calc((100vw - 68px) / 2)',
  '(max-width: 1107px) calc((100vw - 88px) / 3)',
  '253px',
].join(', ');
---
{compact ? (
  <div class="crew-strip">
    {team.map((m) => (
      <a class="crew-chip" href="/team" aria-label={`${m.name}, ${m.role}`}>
        <Image class="crew-portrait" src={art[m.slug]} alt=""
               width={320} widths={[160, 320]} sizes="150px" />
        <span class="chip-name">{m.name}</span>
      </a>
    ))}
  </div>
) : (
  <div class="team-grid">
    {team.map((m) => (
      <article class="team-card">
        <Image class="crew-portrait" src={art[m.slug]} alt={`${m.name}, drawn as a die-cut sticker`}
               width={640} widths={[320, 640]} sizes={GRID_SIZES} />
        <div class="team-body">
          <h3>{m.name}</h3>
          <p class="role">{m.role}</p>
          <p class="bio">{m.bio}</p>
        </div>
      </article>
    ))}
  </div>
)}

---
import { Image } from 'astro:assets';
import about    from '../assets/headers/about.png';
import contact  from '../assets/headers/contact.png';
import news     from '../assets/headers/news.png';
import projects from '../assets/headers/projects.png';
import shop     from '../assets/headers/shop.png';
import team     from '../assets/headers/team.png';

const sheets = { about, contact, news, projects, shop, team } as const;

interface Props { name: keyof typeof sheets; title: string; }
const { name, title } = Astro.props;
---
{/* The graffiti header IS the page title, so it lives inside the <h1> and
    carries the title as its alt text. It used to sit next to a visually
    hidden <h1> with the same words, which made every screen reader announce
    the page name twice, and left nothing at all if the image failed. */}
{/* `width` matters as much as `widths`: without it Astro emits the untouched
    1500px source as the no-srcset fallback `src`, which is ~220 KB for a box
    that is never wider than 520 CSS px. Pinning it to the largest srcset
    entry makes the fallback reuse a file the build already produced. */}
<h1 class="pagehead">
  <Image src={sheets[name]} alt={title} width={760} widths={[360, 520, 760]}
         sizes="(max-width: 640px) 84vw, 520px" loading="eager" />
</h1>
